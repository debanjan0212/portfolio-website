# Copy to .env and fill in. .env is gitignored - never commit a real key.

# Required for the "ask about me" chat agent. Without it the widget shows a
# clear "not configured" message instead of answering.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-4-5.
# AGENT_MODEL=claude-sonnet-4-5

# Optional. Dev server port; defaults to 5173.
# PORT=5173

# --- Nightly digest of unanswered questions ---
# Free tier at resend.com (3,000 emails/month). Without these the digest is
# skipped and logs a warning; the rest of the agent still works.
RESEND_API_KEY=re_...
DIGEST_TO=itsme.deb1995@gmail.com
# Until you verify your own domain in Resend, keep the default sender:
# DIGEST_FROM=Portfolio Agent <onboarding@resend.dev>

# Public site URL, used to build the answer links in the digest email.
# On Netlify this is provided automatically as URL - only set it locally.
SITE_URL=http://localhost:5173
