# Copy to .env and fill in. .env is gitignored - never commit a real key.

# --- The chat agent needs ONE of these. Free options come first. ---
#
# Google Gemini - real free tier, no card required. Get a key at
# aistudio.google.com/apikey. This is the recommended option.
GEMINI_API_KEY=

# Groq - also a free tier, very fast. console.groq.com/keys
# GROQ_API_KEY=

# Paid, no free tier. Only set these if you specifically want them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# If several keys are set, the free providers win. Set this to force one:
# LLM_PROVIDER=gemini

# Optional. Defaults to a sensible model for whichever provider is chosen.
# AGENT_MODEL=

# Optional. Dev server port; defaults to 5173.
# PORT=5173

# --- Nightly digest of unanswered questions ---
# Free tier at resend.com (3,000 emails/month). Without these the digest is
# skipped and logs a warning; the rest of the agent still works.
RESEND_API_KEY=re_...
DIGEST_TO=itsme.deb1995@gmail.com
# Until you verify your own domain in Resend, keep the default sender:
# DIGEST_FROM=Portfolio Agent <onboarding@resend.dev>

# Public site URL, used to build the answer links in the digest email.
# On Netlify this is provided automatically as URL - only set it locally.
SITE_URL=http://localhost:5173
